{
  "name": "puzzles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:header-parity": "node tools/checkHeaderParity.mjs",
    "check:puzzle-schemas": "node --import ./tools/registerSharedContractsResolve.mjs tools/checkPuzzleSchemas.mjs",
    "dedupe:puzzles": "node --import ./tools/registerSharedContractsResolve.mjs tools/dedupePuzzles.mjs",
    "compact:puzzles": "node --import ./tools/registerSharedContractsResolve.mjs tools/compactPuzzleData.mjs",
    "check:migration": "npm run check:header-parity && npm run check:puzzle-schemas && npm test && npm run build",
    "predev": "npm run check:header-parity",
    "dev": "vite",
    "prebuild": "npm run check:header-parity",
    "build": "vite build",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stitches/react": "^1.2.8",
    "copy-to-clipboard": "^3.3.3",
    "fast-printf": "^1.6.9",
    "ismobilejs": "^1.1.1",
    "lodash": "^4.17.21",
    "mobx": "^6.3.13",
    "mobx-react-lite": "^4.1.1",
    "pulltorefreshjs": "^0.1.22",
    "query-string": "^7.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.6.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  }
}
